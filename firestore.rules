rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Set the admin custom claim with the Firebase Admin SDK, never from the client.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Applications collection
    match /applications/{applicationId} {
      // Anyone (public candidates) can submit a new application
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.uid
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.fullName is string
                    && request.resource.data.fullName.size() > 0;

      // Only the authorized administrator can read applications (list and get individual)
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);

      // Only the authorized administrator can update status, stage, or notes
      allow update: if isAdmin();

      // Only the authorized administrator can delete an application
      allow delete: if isAdmin();
    }

    // Configuration / Admin settings collection
    match /settings/{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
